# A short-lived JWT from the real owner account. Never put POS_JWT_SECRET,
# JWT_SECRET, POS_ADMIN_TOKEN, or a Gemini key in this file.
POS_MCP_ACCESS_TOKEN=replace-with-a-current-owner-jwt

# Local API for development. Production must use HTTPS.
POS_API_URL=http://localhost:3000/api
POS_DEFAULT_BUSINESS_ID=replace-with-your-business-id
