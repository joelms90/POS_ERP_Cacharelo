# Local-only Owner Copilot configuration. Copy to apps/sync_api/.env; never commit it.
# Default is the deterministic provider and needs no external key.
OWNER_COPILOT_PROVIDER=local

# To use Gemini locally, uncomment these two lines and put the key only here.
# OWNER_COPILOT_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-your-local-key
# GEMINI_MODEL=gemini-2.5-flash

# The local Make command deliberately does not run database migrations.
SKIP_MIGRATIONS=true
