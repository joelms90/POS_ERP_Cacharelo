# Staging environment values.
# Replace STAGING_PROJECT with the real GCP staging project id, and
# STAGING_API_URL with the Cloud Run URL printed by
#   make infra-apply ENV=staging && terraform -chdir=apps/sync_api/infra/envs/staging output -raw api_url

STAGING_PROJECT=cacharelo-staging
STAGING_REGION=us-central1
STAGING_SERVICE=pos-sync-api
STAGING_DB_INSTANCE=pos-db-instance
STAGING_DB_NAME=pos_db
STAGING_DB_USER=pos_user
STAGING_DB_CONNECTION=$(STAGING_PROJECT):$(STAGING_REGION):$(STAGING_DB_INSTANCE)
STAGING_API_URL=https://REPLACE-WITH-STAGING-CLOUD-RUN-URL/api
STAGING_FIREBASE_SITE_POS=cacharelo-pos-staging
STAGING_FIREBASE_SITE_ADMIN=cacharelo-central-staging
STAGING_RELEASES_BUCKET=cacharelo-pos-releases-staging
STAGING_APK_NAME=pos_flutter_android_staging.apk
STAGING_TFSTATE_BUCKET=cacharelo-tfstate
